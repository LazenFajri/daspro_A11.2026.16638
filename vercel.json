{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/tracker", "destination": "/task-tracker/index.html" },
    { "source": "/tracker/(.*)", "destination": "/task-tracker/$1" },
    { "source": "/task_tracker", "destination": "/task-tracker/index.html" },
    { "source": "/task_tracker/(.*)", "destination": "/task-tracker/$1" },
    { "source": "/style.css", "destination": "/task-tracker/style.css" },
    { "source": "/script.js", "destination": "/task-tracker/script.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|gif|ico|svg|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}

